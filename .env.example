# LOCAL ONLY — read by `docker compose` on your machine, never by the pipeline.
# In production these same settings come from Octopus project variables, injected
# as -e flags at `docker run` time on the droplet. The two paths are independent;
# changing one does not affect the other. Keep the values in sync only if you
# want the local run to mirror prod.
#
# Copy to .env and fill in. NEVER commit .env — the Neon password is the only
# thing protecting the database (Neon's free tier has no IP allowlist).

# Neon POOLED endpoint (host contains "-pooler"), Npgsql format.
# Idle-lifetime settings keep the pool ahead of Neon's scale-to-zero suspend.
EMT_DB_CONNECTION=Host=ep-xxxx-pooler.REGION.aws.neon.tech;Database=emt_identity;Username=USER;Password=PASSWORD;SSL Mode=Require;Trust Server Certificate=true;Connection Idle Lifetime=60;Connection Pruning Interval=10

# Generate with: openssl rand -base64 64
EMT_JWT_KEY=
EMT_JWT_ISSUER=http://localhost:8080
EMT_JWT_AUDIENCE=http://localhost:3000
EMT_CORS_ORIGIN=http://localhost:3000
